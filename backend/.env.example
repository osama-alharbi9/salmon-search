# Copy to backend/.env (`make install` does this for you).
# Everything here is optional for local use: trope search needs no keys and no
# database server.

# Claude, for the vibe field and chat. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Accounts and saved searches. Leave empty to use a local SQLite file at
# backend/data/salmon.db. Postgres example:
#   postgresql+psycopg://USER:PASSWORD@localhost:5432/salmon
DATABASE_URL=

# Signs the login cookie. Empty means a random key per server start, so logins
# reset on restart. Required when SALMON_SECURE_COOKIES is on. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SALMON_SESSION_SECRET=

# Set to 1 when serving over HTTPS with the frontend on a different domain.
SALMON_SECURE_COOKIES=

# Google sign-in. Stays disabled until both are set. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with this redirect URI:
#   http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the frontend runs, for the OAuth redirect and CORS.
SALMON_FRONTEND_URL=http://localhost:3000
SALMON_CORS_ORIGINS=http://localhost:3000
